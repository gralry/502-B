    {
      "id": "1NCP7OJCzKciieDReiuc1",
      "type": "text",
      "x": 710.3997776076345,
      "y": 2207.0662191954116,
      "width": 408.31976318359375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
