      "seed": 1098120124,
      "version": 278,
      "versionNonce": 54090172,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788283886449,
      "link": null,
      "locked": false,
      "text": "1.  T = 0\n    ε = [1, 4]\n    1 si está en cerradura-ε, se omite\n    4 si está en cerradura-ε, se omite\n\n2.  cerradura-ε = [1, 4]\n     Pila = [4, 1]\n     T = 1\n     ε = ∅\n     no hay transiciones ε, no entra al for\n\n3.  cerradura-ε ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.  T = 0\n    ε = [1, 4]\n    1 si está en cerradura-ε, se omite\n    4 si está en cerradura-ε, se omite\n\n2.  cerradura-ε = [1, 4]\n     Pila = [4, 1]\n     T = 1\n     ε = ∅\n     no hay transiciones ε, no entra al for\n\n3.  cerradura-ε ",
      "autoResize": true,
      "lineHeight": 1.25
    },
